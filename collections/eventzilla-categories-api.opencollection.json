{
  "opencollection": "1.0.0",
  "info": {
    "name": "Eventzilla Attendees Categories API",
    "version": "2.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "x-api-key",
      "value": "{{x-api-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Categories",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List event categories",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://www.eventzillaapi.net/api/v2/categories"
          },
          "docs": "Retrieve all available event categories."
        }
      ]
    }
  ],
  "bundled": true
}